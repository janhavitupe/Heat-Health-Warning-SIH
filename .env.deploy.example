# Copy to .env on the server and fill in. Never commit the real .env.

# REQUIRED on any public server: a long random password. Officers type it in the Alerts tab
# before approving alerts; health workers need it to submit reports.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(24))"
HEAT_API_TOKEN=

# 1 = serve the demo copy (May 2024 replay with labelled synthetic reports and simulated
#     approvals; first Red alert left as a draft). 0 = the working database only.
HEAT_DEMO=1
# 1 = rebuild the demo copy on every restart (fresh demo each time)
HEAT_DEMO_RESET=0

# Domain for HTTPS (only with docker-compose.https.yml), e.g. heatwatch.duckdns.org
HEAT_DOMAIN=

# Alert delivery stays simulated unless ALL of these are set (see docs/alerts_phase7.md).
# HEAT_DISPATCH_MODE=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+1XXXXXXXXXX
