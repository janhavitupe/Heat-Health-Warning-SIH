.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# Large or re-downloadable raw data; scripts in scripts/ recreate it
data/raw/*.tif
data/raw/osm/

# Secrets
.env
*.key

# Public source copies that include personal contact details
data/raw/web/uhc_*
data/raw/web/amc_uhc_*
.tmp/

# Daily forecast outputs (regenerated by scripts/run_forecast.py)
data/forecast/

# API database (rebuilt by python -m api.cli all)
data/api/

# Frontend build output and dependencies
frontend/dist/
frontend/node_modules/

# Generated by pip install -e
*.egg-info/

# Walking network (rebuilt by scripts/build_walk_network.py)
data/processed/walk_graph.graphml
